+++ b/tests/test_rv_vbfly_ref.py
@@ -0,0 +1,187 @@
+"""VBFLY's reference (vx.py) against an independent oracle (no vx.py code here).
+
+A full constant-geometry FFT (N = 64, natural-order input in v0 / v8, twiddle table TW[r] =
+W_64^brev5(r) in the 32 RoPE pairs, mask 2^s - 1 at stage s, sc = 1) runs as VBFLY ops; the
+program then VPOWs every output bin (n = 1) into RAM. The bins must equal an independently written
+integer constant-geometry FFT exactly, and numpy's FFT / 64 within the rounding bound; plus random
+single ops (all n, offsets, rhi, masks, sc, int16 extremes) checked element by element.
+"""
+
+import math
+import random
+
+import numpy as np
+import pytest
+
+from chipformer.rv import ref
+from chipformer.rv import spec as S
+from chipformer.rv.asm import assemble
+
+OUT = 0x100
+N, H, L = 64, 32, 6
+
+
+def brev(i, b):
+    return int(format(i, f"0{b}b")[::-1], 2) if b else 0
+
+
+def q15(v):
+    return max(-32768, min(32767, math.floor(32768 * v + 0.5)))
+
+
+TW = [(q15(math.cos(2 * math.pi * brev(r, 5) / N)), q15(-math.sin(2 * math.pi * brev(r, 5) / N))) for r in range(32)]
+
+
+def oracle_stage(x, mask, sc, tw=TW):
+    """One constant-geometry stage on a list of N complex int pairs (independent of vx.py)."""
+    y = [None] * N
+    for i in range(H):
+        (ar, ai), (br, bi) = x[i], x[i + H]
+        c, s = tw[i & mask]
+        tr, ti = c * br - s * bi, c * bi + s * br
+        rnd = 1 << (14 + sc)
+        y[2 * i] = ((ar * 32768 + tr + rnd) >> (15 + sc), (ai * 32768 + ti + rnd) >> (15 + sc))
+        y[2 * i + 1] = ((ar * 32768 - tr + rnd) >> (15 + sc), (ai * 32768 - ti + rnd) >> (15 + sc))
+    return y
+
+
+def vput(reg, pair, a, b):
+    return [f"li t0, {reg * 32 + pair}", f"li t1, {a}", f"li t2, {b}", "vput t0, t1, t2"]
+
+
+def vbfly_word(a, h, dst, woff, rhi, mask, sc, n):
+    return a | h << 3 | dst << 6 | woff << 10 | rhi << 15 | mask << 16 | sc << 21 | n << 22
+
+
+def fft_program(x):
+    """x: N complex int16 pairs with |x| small enough not to overflow. Stage s reads (v0, v8) or
+    (v1, v9) and writes the other pair of registers: outputs 0..31 to bank A, 32..63 to bank B."""
+    lines = []
+    for r, (c, s) in enumerate(TW):
+        lines += [f"li t0, {512 + r}", f"li t1, {c}", f"li t2, {s}", "vput t0, t1, t2"]
+    for i in range(H):
+        lines += vput(0, i, *x[i]) + vput(8, i, *x[i + H])
+    src = 0
+    for s in range(L):
+        dst = 1 - src
+        for op in range(4):  # 8 butterflies each: i0 = 8 op
+            i0 = 8 * op
+            woff, rhi = (2 * i0) % 32, i0 >> 4
+            out_reg = dst if 2 * i0 < 32 else 8 + dst
+            w = vbfly_word(src, src, out_reg, woff, rhi, (1 << s) - 1, 1, 8)
+            lines += [f"li t3, {w}", "vbfly zero, t3, zero"]
+        src = dst
+    # every bin's power through VPOW n = 1 (bank A only: copy bank B's half via VPOW is not
+    # possible, so the last stage's outputs are read from both registers by their own VPOWs)
+    lines.append(f"li a0, {OUT}")
+    for k in range(N):
+        reg, pair = (src, k) if k < H else (None, k - H)
+        if reg is None:
+            continue
+        lines += [f"li t3, {reg | 1 << 3 | (2 * pair) << 9}", "vpow t4, t3, zero", "sw t4, 0(a0)", "addi a0, a0, 4"]
+    lines += ["li a0, 0", "li a7, 93", "ecall"]
+    return assemble("\n".join(lines) + "\n")
+
+
+def run(prog):
+    m = ref.Machine.from_program(prog)
+    toks = m.run(10**7)
+    assert m.halted and m.fault is None and m.exit_code == 0, m.fault
+    return m, toks
+
+
+def signal(seed, amp):
+    rng = np.random.default_rng(seed)
+    z = (rng.normal(size=N) + 1j * rng.normal(size=N)) * amp
+    z = z / max(1.0, np.max(np.abs(z)) / 30000)
+    return [(int(round(v.real)), int(round(v.imag))) for v in z]
+
+
+@pytest.mark.parametrize("seed,amp", [(0, 8000), (1, 20000), (2, 300), (3, 30000)])
+def test_fft64_exact_vs_oracle_and_numpy(seed, amp):
+    x = signal(seed, amp)
+    m, toks = run(fft_program(x))
+    want = list(x)
+    for s in range(L):
+        want = oracle_stage(want, (1 << s) - 1, 1)
+    # the VM after the last stage: bank A register holds outputs 0..31, bank B 32..63
+    src = L % 2  # stages alternate 0 -> 1 -> 0 ...
+    got = [(m.vx.vm[src][2 * i], m.vx.vm[src][2 * i + 1]) for i in range(H)] + \
+          [(m.vx.vm[8 + src][2 * i], m.vx.vm[8 + src][2 * i + 1]) for i in range(H)]
+    assert got == want
+    # powers read through VPOW (bank A half)
+    pw = [m.ram[(OUT >> 2) + k] for k in range(H)]
+    assert pw == [(re * re + im * im) % (1 << 32) for re, im in want[:H]]
+    # DFT / 64 in bit-reversed order, within the rounding bound (6 stages of <= 1 LSB each)
+    ref_fft = np.fft.fft(np.array([complex(*v) for v in x])) / N
+    out = np.array([complex(*want[brev(k, L)]) for k in range(N)])
+    assert np.max(np.abs(out - ref_fft)) < 2 * L, np.max(np.abs(out - ref_fft))
+    assert sum(1 for t in toks if S.family(t)[0] == "VC") >= 3 * 4 * L
+
+
+def test_random_single_ops():
+    rng = random.Random(7)
+    for trial in range(40):
+        n = rng.choice([1, 2, 4, 8])
+        woff = rng.randrange(0, 32 - 2 * n + 1, 2 * n)
+        rhi, mask, sc = rng.randrange(2), rng.randrange(32), rng.randrange(2)
+        a, h = rng.randrange(8), rng.randrange(8)
+        dst = rng.choice([r for r in range(16) if r not in (a, 8 + h)])
+        mem = {}
+        lines = []
+        tw = [(rng.choice([-32768, 32767, rng.randint(-32768, 32767)]), rng.randint(-32768, 32767)) for _ in range(32)]
+        for r, (c, s) in enumerate(tw):
+            lines += [f"li t0, {512 + r}", f"li t1, {c}", f"li t2, {s}", "vput t0, t1, t2"]
+        for reg in {a, 8 + h}:
+            for p in range(32):
+                v = (rng.choice([-32768, 32767, rng.randint(-32768, 32767)]), rng.randint(-32768, 32767))
+                mem[(reg, p)] = v
+                lines += vput(reg, p, *v)
+        lines += [f"li t3, {vbfly_word(a, h, dst, woff, rhi, mask, sc, n)}", "vbfly zero, t3, zero",
+                  "li a0, 0", "li a7, 93", "ecall"]
+        m, toks = run(assemble("\n".join(lines) + "\n"))
+        for j in range(n):
+            i = (woff >> 1) + 16 * rhi + j
+            (ar, ai), (br, bi) = mem[(a, i)], mem[(8 + h, i)]
+            c, s = tw[i & mask]
+            tr, ti = c * br - s * bi, c * bi + s * br
+            rnd = 1 << (14 + sc)
+            for w, sg in ((0, 1), (1, -1)):
+                e = 2 * (woff + 2 * j + w)
+                assert m.vx.vm[dst][e] == (ar * 32768 + sg * tr + rnd) >> (15 + sc), (trial, j, w)
+                assert m.vx.vm[dst][e + 1] == (ai * 32768 + sg * ti + rnd) >> (15 + sc), (trial, j, w)
+        stream = [t for t in toks if S.family(t)[0] in ("VE", "VH")]
+        assert len(stream) >= 8 * n
+
+
+def test_contract_violations_fault():
+    for bad in (vbfly_word(0, 0, 0, 0, 0, 0, 1, 8),     # dst = a
+                vbfly_word(0, 0, 1, 2, 0, 0, 1, 8),     # woff not aligned to 2 n
+                vbfly_word(0, 0, 1, 0, 0, 0, 1, 3)):    # n not a power of two
+        m = ref.Machine.from_program(assemble(f"li t3, {bad}\nvbfly zero, t3, zero\nli a0, 0\nli a7, 93\necall\n"))
+        with pytest.raises(ValueError):  # as every VX op: check() raises on operands outside the contract
+            m.run(10**5)
+
+
+def test_tracked_stage_max():
+    """track: each output streams as VE VE then a word; VGET 3 after a stage (keep 0 on its first
+    op, 1 on the rest) is the bit length of the largest |component| the stage wrote."""
+    rng = random.Random(3)
+    x = signal(5, 9000)
+    lines = []
+    for r, (c, s) in enumerate(TW):
+        lines += [f"li t0, {512 + r}", f"li t1, {c}", f"li t2, {s}", "vput t0, t1, t2"]
+    for i in range(H):
+        lines += vput(0, i, *x[i]) + vput(8, i, *x[i + H])
+    sc = rng.randrange(2)
+    for op in range(8):  # 4 butterflies each
+        i0 = 4 * op
+        w = vbfly_word(0, 0, 1 if 2 * i0 < 32 else 9, (2 * i0) % 32, i0 >> 4, 3, sc, 4) | (op > 0) << 26 | 1 << 27
+        lines += [f"li t3, {w}", "vbfly zero, t3, zero"]
+    lines += ["li t1, 3", "vget s1, t1, zero", f"li a0, {OUT}", "sw s1, 0(a0)", "li a0, 0", "li a7, 93", "ecall"]
+    m, toks = run(assemble("\n".join(lines) + "\n"))
+    want = oracle_stage(x, 3, sc)
+    assert m.ram[OUT >> 2] == max(max(abs(a), abs(b)) for a, b in want).bit_length()
+    assert [(m.vx.vm[1][2 * i], m.vx.vm[1][2 * i + 1]) for i in range(H)] == want[:H]
+    n_words = sum(1 for t in toks if S.family(t)[0] == "VH")
+    assert n_words >= 4 * H  # every output component a word
