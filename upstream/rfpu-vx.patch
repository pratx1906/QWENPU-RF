@@ -218,3 +218,188 @@ def attention_program(seed):
 @pytest.mark.parametrize("seed", range(2))
 def test_attention(circ, seed):
     run_check(circ, attention_program(seed))
+
+
+def i16(rng):
+    return rng.choice([-32768, 32767, 0, -1, rng.randint(-32768, 32767), rng.randint(-32768, 32767)])
+
+
+def vfir(rd, xr, xi, dst, src, h, n, eoff, chain=0, guard=0):
+    cfg = dst | src << 4 | h << 7 | n << 10 | eoff << 15 | chain << 21 | guard << 22
+    return [f"li t1, {(xr & 0xFFFF) | (xi & 0xFFFF) << 16}", f"li t2, {cfg}", f"vfir {rd}, t1, t2"]
+
+
+def vfir_program(seed):
+    """VFIR (vx.py) on random taps, states and samples: single blocks (n 1..16, any aligned
+    offset), blocks chained inside a register and across a register boundary, rd = x0 or not,
+    ping-ponging the state between two register pairs; VEW / VQ after it (slot 1's NEW flag)."""
+    rng = random.Random(seed)
+    a, b = rng.sample([0, 2, 4, 6], 2)  # state areas v{a}, v{a+1} / v{b}, v{b+1}
+    h = rng.choice([0, 2, 4, 6])  # taps in v{8+h}, v{9+h}
+    lines = []
+    for p in range(16):
+        lines += vput(rng, 8 + h, p, i16(rng), i16(rng))
+    for p in range(4):
+        lines += vput(rng, 9 + h, p, i16(rng), i16(rng))
+    for reg in (a, b):
+        for p in list(range(16)) + [31]:
+            lines += vput(rng, reg, p, rng.randint(-(1 << 18), 1 << 18), rng.randint(-(1 << 18), 1 << 18))
+        for p in range(4):
+            lines += vput(rng, reg + 1, p, rng.randint(-(1 << 18), 1 << 18), rng.randint(-(1 << 18), 1 << 18))
+    rds = ["s1", "zero", "s2", "a0"]
+    for k in range(7):
+        src, dst = (a, b) if k % 2 == 0 else (b, a)
+        x = (i16(rng), i16(rng))
+        mode = rng.randrange(3)
+        if mode == 0:  # one block
+            n = rng.choice([1, 2, 3, 4, 5, 8, 16])
+            span = 1 << (2 * n - 1).bit_length()
+            eoff = rng.randrange(0, 64 - 2 * n + 1, span)
+            lines += vfir(rng.choice(rds), *x, dst, src, h, n, eoff, 0, rng.randrange(2))
+        elif mode == 1:  # two chained blocks of m inside the register
+            m = rng.choice([2, 4, 8])
+            lines += vfir("zero", *x, dst, src, h, m, 0)
+            lines += vfir(rng.choice(rds), *x, dst, src, h, m, 2 * m, 1, rng.randrange(2))
+        else:  # the last pair of v{src} chains into a block at v{src+1}, offset 0
+            n = rng.choice([1, 2, 4])
+            lines += vfir("zero", *x, dst, src, h, 1, 62)
+            lines += vfir(rng.choice(rds), *x, dst + 1, src + 1, h + 1, n, 0, 1, rng.randrange(2))
+        if rng.random() < 0.3:
+            lines += ["xor s3, s3, s1", "add s3, s3, s2"]
+    lines += vew(a, 8 + h, 0, 8, 0, 0, 0, -3, 0, rng.randrange(1 << 15))
+    lines += vq(b, 0, 16, 0, rng.randrange(4, 10), 64 * 2, rng.randrange(1 << 15))
+    return assemble("\n".join(lines) + EXIT)
+
+
+@pytest.mark.parametrize("seed", range(4))
+def test_vfir(circ, seed):
+    toks = run_check(circ, vfir_program(seed))
+    fams = [S.family(t)[0] for t in toks]
+    assert fams.count("VC") >= 5 * 7
+
+
+def vpow(rd, src, n, eoff):
+    return [f"li t3, {src | n << 3 | eoff << 9}", f"vpow {rd}, t3, zero"]
+
+
+def vpow_program(seed):
+    """VPOW (vx.py) on random complex int16 pairs in bank A (the extremes -32768 / 32767 included):
+    n 1..32 at aligned offsets, rd = x0 or not, with VGET 1 (vsum), and VFIR / VEW / VQ / VPUT
+    before and after it (the shared MAC, slot 1's NEW flag, the bank A query)."""
+    rng = random.Random(seed)
+    regs = rng.sample(range(8), 3)
+    h = rng.choice([0, 2, 4, 6])
+    lines = []
+    for reg in regs:
+        for p in range(32):
+            a, b = i16(rng), i16(rng)
+            if rng.random() < 0.1:
+                a, b = rng.choice([(-32768, -32768), (32767, 32767), (-32768, 32767)])
+            lines += vput(rng, reg, p, a, b)
+    for p in range(8):
+        lines += vput(rng, 8 + h, p, i16(rng), i16(rng))
+    rds = ["s1", "zero", "s2", "a0"]
+    fa, fb = [r for r in range(8) if r not in regs][:2]  # VFIR's state registers
+    for p in range(8):
+        lines += vput(rng, fa, p, rng.randint(-(1 << 18), 1 << 18), rng.randint(-(1 << 18), 1 << 18))
+    for k in range(8):
+        n = rng.choice([1, 2, 3, 5, 8, 16, 31, 32, rng.randint(1, 32)])
+        span = 1 << (2 * n - 1).bit_length()
+        eoff = rng.randrange(0, 64 - 2 * n + 1, span)
+        lines += vpow(rng.choice(rds), rng.choice(regs), n, eoff)
+        r = rng.random()
+        if r < 0.3:
+            lines += ["li t1, 1", "vget s3, t1, zero", "xor s2, s2, s3"]
+        elif r < 0.55:
+            src, dst = (fa, fb) if k % 2 == 0 else (fb, fa)
+            lines += vfir(rng.choice(rds), i16(rng), i16(rng), dst, src, h, rng.choice([1, 2, 4]), 0)
+        elif r < 0.7:
+            lines += vq(rng.choice(regs), 0, 16, 0, rng.randrange(0, 4), 64 * 2, rng.randrange(1 << 15))
+        elif r < 0.85:
+            lines += vput(rng, rng.choice(regs), rng.randrange(32), i16(rng), i16(rng))
+    lines += vew(regs[0], 8 + h, 0, 8, 0, 0, 0, -3, 0, rng.randrange(1 << 15))
+    lines += vpow("s1", regs[1], 4, 8)
+    for p in range(24, 32):  # small elements: short value records (F0, F1)
+        lines += vput(rng, regs[2], p, rng.randint(-90, 90), rng.randint(-90, 90))
+    lines += vpow("s2", regs[2], 1, 48) + vpow("a0", regs[2], 8, 48) + vpow("zero", regs[2], 2, 60)
+    lines += vpow("s1", regs[2], 16, 32)
+    return assemble("\n".join(lines) + EXIT)
+
+
+@pytest.mark.parametrize("seed", range(6))
+def test_vpow(circ, seed):
+    toks = run_check(circ, vpow_program(seed))
+    fams = [S.family(t)[0] for t in toks]
+    assert fams.count("VC") >= 3 * 9
+
+
+def vbfly(a, h, dst, woff, rhi, mask, sc, n, keep=0, track=0):
+    w = a | h << 3 | dst << 6 | woff << 10 | rhi << 15 | mask << 16 | sc << 21 | n << 22 | keep << 26 | track << 27
+    return [f"li t3, {w}", "vbfly zero, t3, zero"]
+
+
+def vbfly_program(seed):
+    """VBFLY (vx.py) on random int16 pairs (extremes included): n in 1, 2, 4, 8 at aligned offsets,
+    both halves (rhi), random masks into 32 random RoPE pairs, sc 0 / 1, outputs chained into a
+    second VBFLY; with VEW ROPE (the RoPE table's first 4 pairs), VFIR, VPOW, VQ, VPUT around it
+    (the shared MAC, the NEW / BFLY flags, both banks' queries)."""
+    rng = random.Random(seed)
+    ra, rb = rng.randrange(8), rng.randrange(8)
+    lines = []
+    for r in range(32):
+        c, s = rng.choice([(-32768, 32767), (32767, -32768), (i16(rng), i16(rng)), (i16(rng), i16(rng))])
+        lines += [f"li t0, {512 + r}", f"li t1, {c}", f"li t2, {s}", "vput t0, t1, t2"]
+    for reg, lim in ((ra, 32768), (8 + rb, 32768)):
+        for p in range(32):
+            lines += vput(rng, reg, p, rng.choice([i16(rng), rng.randint(-lim, lim - 1)]), i16(rng))
+    others_a = [r for r in range(8) if r != ra]
+    others_b = [r for r in range(8, 16) if r != 8 + rb]
+    fa, fb = others_a[:2]
+    for p in range(8):
+        lines += vput(rng, fa, p, rng.randint(-(1 << 18), 1 << 18), rng.randint(-(1 << 18), 1 << 18))
+    for k in range(10):
+        n = rng.choice([1, 2, 4, 8, 8])
+        woff = rng.randrange(0, 32 - 2 * n + 1, 2 * n)
+        dst = rng.choice(others_a[2:] + others_b)
+        track = int(n <= 4 and rng.random() < 0.6)
+        lines += vbfly(ra, rb, dst, woff, rng.randrange(2), rng.randrange(32), rng.randrange(2), n,
+                       rng.randrange(2), track)
+        if track and rng.random() < 0.5:
+            lines += ["li t1, 3", "vget s3, t1, zero", "xor s2, s2, s3", "li t1, 0", "vget s3, t1, zero"]
+        r = rng.random()
+        if r < 0.25:
+            src, d2 = (fa, fb) if k % 2 == 0 else (fb, fa)
+            lines += vfir(rng.choice(["s1", "zero"]), i16(rng), i16(rng), d2, src, rb, rng.choice([1, 2, 4]), 0)
+        elif r < 0.45:
+            lines += vpow(rng.choice(["s2", "zero"]), ra, rng.choice([1, 4, 8]), 0)
+        elif r < 0.6:
+            lines += vew(ra, 8 + rb, 0, 8, 2, 0, 0, 0, 0, 0)  # ROPE into VM[8 + rb] (then rb's data
+            # are RoPE outputs: refill below)
+            for p in range(4):
+                lines += vput(rng, 8 + rb, p, i16(rng), i16(rng))
+        elif r < 0.75:
+            lines += vq(ra, 0, 16, 0, rng.randrange(0, 4), 64 * 2, rng.randrange(1 << 15))
+        elif r < 0.9:
+            lines += vput(rng, rng.choice([ra, 8 + rb]), rng.randrange(32), i16(rng), i16(rng))
+    # chained: small inputs, a stage into others_a[3] / others_b[0], then a second stage from them
+    sa, sb = others_a[3], others_b[1]
+    for p in range(32):
+        lines += vput(rng, sa, p, rng.randint(-15000, 15000), rng.randint(-15000, 15000))
+        lines += vput(rng, sb, p, rng.randint(-15000, 15000), rng.randint(-15000, 15000))
+    oa, ob = others_a[4], others_b[2]
+    for op in range(4):
+        i0 = 8 * op
+        lines += vbfly(sa, sb - 8, oa if 2 * i0 < 32 else ob, (2 * i0) % 32, i0 >> 4, 0, 1, 8)
+    for op in range(8):  # tracked: 4 butterflies an op
+        i0 = 4 * op
+        lines += vbfly(oa, ob - 8, sa if 2 * i0 < 32 else sb, (2 * i0) % 32, i0 >> 4, 1, 1, 4, int(op > 0), 1)
+    lines += ["li t1, 3", "vget s3, t1, zero", "li t1, 0", "vget s1, t1, zero"]
+    lines += vpow("s1", sa, 8, 16)
+    return assemble("\n".join(lines) + EXIT)
+
+
+@pytest.mark.parametrize("seed", range(6))
+def test_vbfly(circ, seed):
+    toks = run_check(circ, vbfly_program(seed))
+    fams = [S.family(t)[0] for t in toks]
+    assert fams.count("VC") >= 3 * 10
