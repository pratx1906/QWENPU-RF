+++ b/tests/test_rv_vfir_ref.py
@@ -0,0 +1,180 @@
+"""VFIR's reference (vx.py) against an independent direct-form oracle (no vx.py code here).
+
+A ping-pong loop of VFIR calls over a sample stream (state register src -> dst, then back) must
+give, at every sample n, rd = sat16 of y[n] = sum_k rhu(g_k x[n - k] / 2^15) (complex, rounded
+half up once per component), with the taps stored reversed (h_j = g_{N-1-j}). The full (unsaturated)
+y[n] is checked in the state register too.
+"""
+
+import random
+
+import pytest
+
+from chipformer.rv import ref
+from chipformer.rv import spec as S
+from chipformer.rv.asm import assemble
+
+OUT = 0x100  # RAM byte address of the rd results
+
+
+def rhu15(v):
+    return (v + (1 << 14)) >> 15
+
+
+def oracle(g, xs):
+    """Direct form: y[n] = sum_k rhu(g_k x[n-k] / 2^15) per component, complex g, x."""
+    ys = []
+    for n in range(len(xs)):
+        yr = yi = 0
+        for k, (gr, gi) in enumerate(g):
+            if n - k < 0:
+                continue
+            xr, xi = xs[n - k]
+            yr += rhu15(gr * xr - gi * xi)
+            yi += rhu15(gr * xi + gi * xr)
+        ys.append((yr, yi))
+    return ys
+
+
+def sat16(v):
+    return max(-32768, min(32767, v))
+
+
+def i16(rng):
+    return rng.choice([-32768, 32767, -32767, 0, 1, -1, rng.randint(-32768, 32767),
+                       rng.randint(-32768, 32767)])
+
+
+HREG = 9  # the taps' first register (flat pair 32 HREG + p holds h_p)
+STATE = (2, 4)  # the two state areas (first registers; a 64-tap state takes two registers)
+
+
+def fir_program(g, xs, blk, rd="s1"):
+    """VPUT the reversed taps from v9, then per sample the chained blocks of blk taps (state in
+    v2.. / v4.., ping-pong), storing rd of the last block to OUT + 4 n."""
+    N = len(g)
+    h = g[::-1]
+    lines = []
+    for p in range(N):
+        lines += [f"li t0, {HREG * 32 + p}", f"li t1, {h[p][0]}", f"li t2, {h[p][1]}",
+                  "vput t0, t1, t2"]
+    for n, (xr, xi) in enumerate(xs):
+        s0, d0 = STATE if n % 2 == 0 else STATE[::-1]
+        lines.append(f"li t1, {(xr & 0xFFFF) | (xi & 0xFFFF) << 16}")
+        for b in range(N // blk):
+            last = b == N // blk - 1
+            q = blk * b  # the block's first tap
+            src, dst, hh, eoff = s0 + q // 32, d0 + q // 32, HREG - 8 + q // 32, 2 * (q % 32)
+            cfg = dst | src << 4 | hh << 7 | blk << 10 | eoff << 15 | (b > 0) << 21
+            lines += [f"li t2, {cfg}", f"vfir {rd if last else 'zero'}, t1, t2"]
+        lines.append(f"sw {rd}, {OUT + 4 * n}(zero)")
+    return assemble("\n".join(lines) + "\nli a7, 93\necall")
+
+
+def run(g, xs, blk, rd="s1"):
+    m = ref.Machine.from_program(fir_program(g, xs, blk, rd))
+    toks = m.run(10**7)
+    assert S.family(toks[-1])[0] == "HALT" and m.fault is None
+    return m, toks
+
+
+@pytest.mark.parametrize("seed", range(4))
+@pytest.mark.parametrize("N", [1, 2, 4, 8, 16])
+def test_vfir_ping_pong_equals_direct_form(N, seed):
+    rng = random.Random(1000 * N + seed)
+    g = [(i16(rng), i16(rng)) for _ in range(N)]
+    xs = [(i16(rng), i16(rng)) for _ in range(2 * N + 5)]
+    m, _ = run(g, xs, N)
+    want = oracle(g, xs)
+    for n, (yr, yi) in enumerate(want):
+        got = m.ram[(OUT >> 2) + n]
+        assert got == (sat16(yr) & 0xFFFF | (sat16(yi) & 0xFFFF) << 16), (n, got, yr, yi)
+    # the last tap's state holds the unsaturated output
+    last = STATE[1] if len(xs) % 2 else STATE[0]  # the register the last sample wrote
+    assert (m.vx.vm[last][2 * N - 2], m.vx.vm[last][2 * N - 1]) == want[-1]
+
+
+@pytest.mark.parametrize("seed", range(3))
+@pytest.mark.parametrize("N,blk", [(32, 16), (64, 16), (64, 8), (16, 4), (8, 2)])
+def test_vfir_chained_blocks(N, blk, seed):
+    rng = random.Random(77 * N + blk + seed)
+    g = [(i16(rng), i16(rng)) for _ in range(N)]
+    xs = [(i16(rng), i16(rng)) for _ in range(N + 6)]
+    m, _ = run(g, xs, blk)
+    want = oracle(g, xs)
+    for n, (yr, yi) in enumerate(want):
+        assert m.ram[(OUT >> 2) + n] == (sat16(yr) & 0xFFFF | (sat16(yi) & 0xFFFF) << 16), n
+
+
+def test_vfir_tokens_and_rd_zero():
+    """The record: 5 VC, 4 tokens a tap, then rd's value record (NT for x0)."""
+    rng = random.Random(5)
+    g = [(i16(rng), i16(rng)) for _ in range(4)]
+    xs = [(i16(rng), i16(rng)) for _ in range(3)]
+    for rd in ("s1", "zero"):
+        prog = fir_program(g, xs, 4, rd)
+        m = ref.Machine.from_program(prog)
+        recs = []
+        while not m.halted:
+            ins = ref.decode(m.rom[m.anchor + m.n])
+            r = m.record()
+            if ins.op == "VFIR":
+                recs.append([S.family(t)[0] for t in r])
+        assert len(recs) == 3
+        for fams in recs:
+            assert fams[:5] == ["VC"] * 5
+            assert fams[5:5 + 16] == ["VE", "VH"] * 8
+            tail = fams[21:]
+            if rd == "zero":
+                assert tail == ["NT"]
+            else:
+                assert tail[-1] in ("F0", "F1", "F2") and all(t == "V" for t in tail[:-1])
+
+
+@pytest.mark.parametrize("bad", ["dst_is_src", "dst_is_h", "n0", "n17", "misaligned", "chain0", "chain_into_dst"])
+def test_vfir_operand_checks(bad):
+    cfg = {"dst_is_src": 1 | 1 << 4 | 1 << 7 | 4 << 10,
+           "dst_is_h": 9 | 1 << 4 | 1 << 7 | 4 << 10,
+           "n0": 2 | 1 << 4 | 1 << 7,
+           "n17": 2 | 1 << 4 | 1 << 7 | 17 << 10,
+           "misaligned": 2 | 1 << 4 | 1 << 7 | 4 << 10 | 4 << 15,
+           "chain0": 2 | 0 << 4 | 1 << 7 | 4 << 10 | 1 << 21,
+           "chain_into_dst": 0 | 1 << 4 | 1 << 7 | 4 << 10 | 1 << 21}[bad]
+    prog = assemble(f"li t1, 5\nli t2, {cfg}\nvfir s1, t1, t2\nli a7, 93\necall")
+    with pytest.raises(ValueError):
+        ref.Machine.from_program(prog).run()
+
+
+def test_vfir_decode():
+    prog = assemble("vfir s1, t1, t2")
+    w = prog.text[0]
+    assert w & 0x7F == 0x5B and w >> 25 == 1 and w >> 12 & 7 == 0
+    ins = ref.decode(w)
+    assert (ins.op, ins.rd, ins.rs1, ins.rs2) == ("VFIR", 9, 6, 7)
+    assert ref.rom_word(w, S.ROM_BASE) & 0x7F == 81
+
+
+@pytest.mark.parametrize("seed", range(4))
+def test_vfir_guard_rd(seed):
+    """guard (rs2 bit 22): rd = sat16(y >> 2) per component, y the last tap's state (unchanged)."""
+    from chipformer.rv import vx as V
+    rng = random.Random(100 + seed)
+    taps = [(rng.randint(-24000, 24000), rng.randint(-24000, 24000)) for _ in range(8)]
+    lines = []
+    for j, (hr, hi) in enumerate(taps):
+        lines += [f"li t0, {8 * 32 + j}", f"li t1, {hr}", f"li t2, {hi}", "vput t0, t1, t2"]
+    chain_pair = (rng.choice([2, 0, -7]), rng.choice([2, 5]))
+    lines += [f"li t0, {31}", f"li t1, {chain_pair[0]}", f"li t2, {chain_pair[1]}", "vput t0, t1, t2"]
+    xr, xi = rng.randint(-32768, 32767), rng.randint(-32768, 32767)
+    for guard in (0, 1):
+        cfg = 2 | 1 << 4 | 0 << 7 | 8 << 10 | 0 << 15 | 0 << 21 | guard << 22
+        prog = assemble("\n".join(lines + [f"li t1, {(xr & 0xFFFF) | (xi & 0xFFFF) << 16}", f"li t2, {cfg}",
+                                           "vfir s1, t1, t2", f"sw s1, {OUT}(zero)", "li a0, 0", "li a7, 93", "ecall"]) + "\n")
+        m = ref.Machine.from_program(prog)
+        m.run(10**6)
+        assert m.halted and m.fault is None
+        yr, yi = m.vx.vm[2][14], m.vx.vm[2][15]
+        g = 2 * guard
+        r = m.ram[OUT >> 2]
+        got = (r & 0xFFFF) - ((r & 0x8000) << 1), (r >> 16 & 0xFFFF) - ((r >> 16 & 0x8000) << 1)
+        assert got == (sat16(yr >> g), sat16(yi >> g)), (guard, got, yr, yi)
diff --git a/tests/test_rv_vpow_ref.py b/tests/test_rv_vpow_ref.py
new file mode 100644
index 0000000..09bf9ba
--- /dev/null
+++ b/tests/test_rv_vpow_ref.py
@@ -0,0 +1,155 @@
+"""VPOW's reference (vx.py) against an independent oracle (no vx.py code here).
+
+Random complex int16 pairs are VPUT into v0..v7 (a test-side copy is kept), then VPOW over random
+(src, n, eoff) blocks stores rd to RAM; rd must be sum (ar^2 + ai^2) mod 2^32 over the block,
+VGET 1 (vsum) its low 31 bits sign-extended, and the streamed VE / VH pairs the running sums.
+"""
+
+import random
+
+import pytest
+
+from chipformer.rv import ref
+from chipformer.rv import spec as S
+from chipformer.rv.asm import assemble
+
+OUT = 0x100  # RAM byte address of the results
+M32 = (1 << 32) - 1
+
+
+def i16(rng):
+    return rng.choice([-32768, 32767, -32767, 0, 1, -1, rng.randint(-32768, 32767),
+                       rng.randint(-32768, 32767)])
+
+
+def oracle(mem, src, n, eoff):
+    acc, run = 0, []
+    for j in range(n):
+        ar, ai = mem[src][eoff + 2 * j], mem[src][eoff + 2 * j + 1]
+        acc = (acc + ar * ar + ai * ai) % (1 << 32)
+        run.append(acc)
+    return acc, run
+
+
+def to_s31(v):
+    v &= (1 << 31) - 1
+    return v - (1 << 31) if v >> 30 else v
+
+
+def block(rng):
+    n = rng.choice([1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, rng.randint(1, 32)])
+    span = 1 << (2 * n - 1).bit_length()  # elements: 2 n rounded up to a power of two
+    eoff = rng.randrange(0, 64 - 2 * n + 1, span)
+    return n, eoff
+
+
+def program(seed, n_ops=10):
+    rng = random.Random(seed)
+    mem = [[0] * 64 for _ in range(8)]
+    lines = []
+    for reg in rng.sample(range(8), 3):
+        for p in range(32):
+            a, b = i16(rng), i16(rng)
+            if rng.random() < 0.15:  # the extremes, both components
+                a, b = rng.choice([(-32768, -32768), (32767, 32767), (-32768, 32767)])
+            mem[reg][2 * p], mem[reg][2 * p + 1] = a, b
+            lines += [f"li t0, {reg * 32 + p}", f"li t1, {a}", f"li t2, {b}", "vput t0, t1, t2"]
+    want = []
+    for k in range(n_ops):
+        src = rng.randrange(8)
+        n, eoff = block(rng)
+        acc, _ = oracle(mem, src, n, eoff)
+        want.append((acc, to_s31(acc) & M32, src, n, eoff))
+        lines += [f"li t3, {src | n << 3 | eoff << 9}", "vpow s1, t3, zero",
+                  f"sw s1, {OUT + 8 * k}(zero)", "li t4, 1", "vget s2, t4, zero",
+                  f"sw s2, {OUT + 8 * k + 4}(zero)"]
+    return assemble("\n".join(lines) + "\nli a7, 93\necall"), want, mem
+
+
+@pytest.mark.parametrize("seed", range(8))
+def test_vpow_equals_oracle(seed):
+    prog, want, mem = program(seed)
+    m = ref.Machine.from_program(prog)
+    toks = m.run(10**7)
+    assert S.family(toks[-1])[0] == "HALT" and m.fault is None
+    for k, (acc, vs, src, n, eoff) in enumerate(want):
+        assert m.ram[(OUT >> 2) + 2 * k] == acc, (k, src, n, eoff)
+        assert m.ram[(OUT >> 2) + 2 * k + 1] == vs, k
+
+
+def test_vpow_full_scale_wraps():
+    """32 pairs of (-32768, -32768): 32 * 2^31 = 2^36, so acc wraps to 0 mod 2^32."""
+    lines = []
+    for p in range(32):
+        lines += [f"li t0, {3 * 32 + p}", "li t1, -32768", "li t2, -32768", "vput t0, t1, t2"]
+    lines += [f"li t3, {3 | 32 << 3}", "vpow s1, t3, zero", f"sw s1, {OUT}(zero)",
+              f"li t3, {3 | 1 << 3 | 62 << 9}", "vpow s1, t3, zero", f"sw s1, {OUT + 4}(zero)",
+              f"li t3, {3 | 3 << 3 | 56 << 9}", "vpow s1, t3, zero", f"sw s1, {OUT + 8}(zero)"]
+    m = ref.Machine.from_program(assemble("\n".join(lines) + "\nli a7, 93\necall"))
+    m.run(10**7)
+    assert m.ram[OUT >> 2] == 0
+    assert m.ram[(OUT >> 2) + 1] == 1 << 31
+    assert m.ram[(OUT >> 2) + 2] == (3 << 31) & M32
+
+
+@pytest.mark.parametrize("rd", ["s1", "zero"])
+def test_vpow_record(rd):
+    """The record: 3 VC, VE VH per element with the running sums, then rd's value record (NT for
+    x0)."""
+    prog, want, mem = program(3, n_ops=6)
+    m = ref.Machine.from_program(prog)
+    k = 0
+    while not m.halted:
+        ins = ref.decode(m.rom[m.anchor + m.n])
+        r = m.record()
+        if ins.op != "VPOW":
+            continue
+        acc, _, s, n, eoff = want[k]
+        k += 1
+        _, run = oracle(mem, s, n, eoff)
+        fams = [S.family(t) for t in r]
+        assert [f for f, _ in fams[:3]] == ["VC"] * 3
+        stream = fams[3:3 + 2 * n]
+        assert [f for f, _ in stream] == ["VE", "VH"] * n
+        for j in range(n):
+            assert stream[2 * j][1] | stream[2 * j + 1][1] << 16 == run[j]
+        assert r[3 + 2 * n:] == S.value_record(acc)
+    assert k == 6
+    # rd = x0: NT after the stream
+    lines = ["li t0, 5", "li t1, 300", "li t2, -4", "vput t0, t1, t2",
+             f"li t3, {0 | 1 << 3 | 10 << 9}", f"vpow {rd}, t3, zero", "li a7, 93", "ecall"]
+    m = ref.Machine.from_program(assemble("\n".join(lines)))
+    recs = []
+    while not m.halted:
+        ins = ref.decode(m.rom[m.anchor + m.n])
+        r = m.record()
+        if ins.op == "VPOW":
+            recs.append(r)
+    (r,) = recs
+    assert [S.family(t)[0] for t in r[:5]] == ["VC", "VC", "VC", "VE", "VH"]
+    if rd == "zero":
+        assert [S.family(t)[0] for t in r[5:]] == ["NT"]
+    else:
+        assert r[5:] == S.value_record(300 * 300 + 16)
+
+
+@pytest.mark.parametrize("bad", ["n0", "n33", "odd_eoff", "misaligned", "past_end", "not_int16"])
+def test_vpow_operand_checks(bad):
+    pre = ""
+    cfg = {"n0": 1, "n33": 1 | 33 << 3, "odd_eoff": 1 | 1 << 3 | 1 << 9,
+           "misaligned": 1 | 4 << 3 | 4 << 9, "past_end": 1 | 2 << 3 | 62 << 9,
+           "not_int16": 1 | 1 << 3}[bad]
+    if bad == "not_int16":
+        pre = "li t0, 32\nli t1, 32768\nli t2, 0\nvput t0, t1, t2\n"
+    prog = assemble(pre + f"li t3, {cfg}\nvpow s1, t3, zero\nli a7, 93\necall")
+    with pytest.raises(ValueError):
+        ref.Machine.from_program(prog).run()
+
+
+def test_vpow_decode():
+    prog = assemble("vpow s1, t3, zero")
+    w = prog.text[0]
+    assert w & 0x7F == 0x5B and w >> 25 == 1 and w >> 12 & 7 == 1
+    ins = ref.decode(w)
+    assert (ins.op, ins.rd, ins.rs1, ins.rs2) == ("VPOW", 9, 28, 0)
+    assert ref.rom_word(w, S.ROM_BASE) & 0x7F == 82
diff --git a/tests/test_rv_vx.py b/tests/test_rv_vx.py
index 63d9ac5..e95dd69 100644
