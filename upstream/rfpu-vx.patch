+    stream("VBFLY", 3, gb + [trk_b, sub_eq(2)], "VE", lag_ve[1])
+    stream("VBFLY", 3, gb + [trk_b, sub_eq(3)], "VH", list(lag_ve[1][0:15]) + [ZERO])
+    yl = list(lag_ve[2]) + list(lag_ve[1][0:15])
+    bcmp = compare(c, yl + [yl[30]], absv, "vx.bf")
+    flag = [ZERO] * 15 + [one]
+    tr3 = gb + [trk_b, sub_eq(3)]
+    stream("VBFLY", 3, tr3 + [el_eq(0), 1 - keepb], None, flag)
+    for cond in ([bcmp["o"]], [1 - bcmp["o"], bcmp["n"]]):
+        stream("VBFLY", 3, tr3 + [velt[0]] + cond, None, flag)
+        stream("VBFLY", 3, tr3 + [el_eq(0), keepb] + cond, None, flag)
+    stream("VBFLY", 3, [done_w], "NT")
     # VMATR: VC slots 0, 2, 3, 4, 5. Scores: a word an output (signed max); p.V: raw (VE VE), then
     # out = raw s >> 12 (a word)
     vc_case("VMATR", 0, 0, [(C[0:4], 4), (A[11:16], 5), ([1 - C[10], ZERO, one], 3)])
